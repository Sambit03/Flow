# Environment Configuration for Flow

# Node Environment
NODE_ENV=development

# API Server
API_PORT=5000
API_HOST=localhost

# Web App
WEB_PORT=3000

# Database - PostgreSQL (via Neon)
# For local development with Docker:
DATABASE_URL=postgresql://flow_user:flow_password@localhost:5432/flow_db
# For production (Neon):
# DATABASE_URL=postgresql://username:password@xxx.neon.tech/flow_db?sslmode=require

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# For production:
# REDIS_URL=redis://:password@host:port

# Supabase Authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# BullMQ Job Queue
BULLMQ_QUEUE_NAME=workflow-execution
BULLMQ_MAX_RETRIES=3

# Application Settings
LOG_LEVEL=info
ENABLE_DEBUG=false

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
